"""
nClimGrid-Daily (NOAA NCEI) -- FULL RUN, 2000-01 .. 2023-12
------------------------------------------------------------
Daily tmax, tmin, prcp on the ~5 km (1/24-degree) grid, clipped to Louisiana.

Shared-mount safe: every netCDF open/write happens on local disk (SCRATCH_DIR);
finished files are moved to /icebox with a plain byte copy. This works around the
HDF5 file-locking failure on that mount.

Resumable: any month already present on the share is skipped, so if this dies
partway through, just run it again.

Best run detached rather than in a notebook cell:
    nohup python download_nclimgrid_full.py > download.log 2>&1 &
    tail -f download.log
"""

import os

# must be set before netCDF4 / h5py are imported anywhere in the session
os.environ["HDF5_USE_FILE_LOCKING"] = "FALSE"

import shutil
import sys
import time
from datetime import timedelta
from pathlib import Path

import requests
import xarray as xr

# ============================================================
# SETTINGS
# ============================================================

BASE_URL = "https://www.ncei.noaa.gov/data/nclimgrid-daily/access/grids"

SHARE_DIR = Path("/icebox/data/shares/mh1/fgorginpaveh/Tuft/Climate Data")
SCRATCH_DIR = Path("/bighome/fgorginpaveh/nclim_scratch")

START_YEAR, START_MONTH = 2000, 1
END_YEAR, END_MONTH = 2023, 12

VARIABLES = ["tmax", "tmin", "prcp"]

REGION = "louisiana"          # or "los_angeles"

BBOXES = {
    # (lat_min, lat_max, lon_min, lon_max)  -- lon in degrees EAST (negative = W)
    "louisiana":   (28.80, 33.10, -94.15, -88.70),
    "los_angeles": (33.60, 34.90, -118.95, -117.60),
}

MAX_RETRIES = 3               # per month, per filename variant
RETRY_WAIT = 20               # seconds between retries

DEST_DIR = SHARE_DIR / f"subset_{REGION}"
FAILED_FILE = SHARE_DIR / f"failed_downloads_{REGION}.txt"

# ============================================================


def month_iter(y0, m0, y1, m1):
    y, m = y0, m0
    while (y, m) <= (y1, m1):
        yield y, m
        m += 1
        if m == 13:
            y, m = y + 1, 1


def download_month(year, month, dest):
    """Download the CONUS monthly netCDF to local scratch. 'scaled' first, then 'prelim'."""
    if dest.exists() and dest.stat().st_size > 0:
        print(f"[SKIP] raw already present: {dest.name}", flush=True)
        return dest

    for kind in ("scaled", "prelim"):
        url = f"{BASE_URL}/{year}/ncdd-{year}{month:02d}-grd-{kind}.nc"

        for attempt in range(1, MAX_RETRIES + 1):
            try:
                with requests.get(url, stream=True, timeout=300) as r:
                    if r.status_code == 404:
                        break                      # this variant doesn't exist; try the next
                    if r.status_code != 200:
                        print(f"[WARN] HTTP {r.status_code} (attempt {attempt}) {url}", flush=True)
                        time.sleep(RETRY_WAIT)
                        continue

                    total = int(r.headers.get("content-length", 0))
                    got = 0
                    tmp = dest.with_suffix(".part")
                    with open(tmp, "wb") as f:
                        for chunk in r.iter_content(chunk_size=4 * 1024 * 1024):
                            if chunk:
                                f.write(chunk)
                                got += len(chunk)

                    if total and got != total:
                        print(f"[WARN] short read {got}/{total} (attempt {attempt})", flush=True)
                        tmp.unlink(missing_ok=True)
                        time.sleep(RETRY_WAIT)
                        continue

                    tmp.rename(dest)
                    print(f"[OK  ] {dest.name}  {dest.stat().st_size / 1e6:.1f} MB  [{kind}]",
                          flush=True)
                    return dest

            except Exception as e:
                print(f"[WARN] {type(e).__name__} (attempt {attempt}) {url}: {e}", flush=True)
                time.sleep(RETRY_WAIT)

    print(f"[FAIL] could not download {year}-{month:02d}", flush=True)
    return None


def subset_month(nc_path, bbox, out_path):
    """Clip to bbox, keep tmax/tmin/prcp. Both paths must be on local disk."""
    lat_min, lat_max, lon_min, lon_max = bbox

    with xr.open_dataset(nc_path) as ds:
        have = [v for v in VARIABLES if v in ds.data_vars]
        missing = set(VARIABLES) - set(have)
        if missing:
            print(f"[WARN] {nc_path.name}: missing {sorted(missing)}", flush=True)

        ds = ds[have]

        lat_asc = float(ds.lat[1] - ds.lat[0]) > 0
        lon_asc = float(ds.lon[1] - ds.lon[0]) > 0
        lat_slice = slice(lat_min, lat_max) if lat_asc else slice(lat_max, lat_min)
        lon_slice = slice(lon_min, lon_max) if lon_asc else slice(lon_max, lon_min)

        sub = ds.sel(lat=lat_slice, lon=lon_slice)

        if sub.sizes.get("lat", 0) == 0 or sub.sizes.get("lon", 0) == 0:
            raise ValueError("Empty subset -- check the bbox / longitude sign.")

        enc = {v: {"zlib": True, "complevel": 4} for v in sub.data_vars}
        sub.to_netcdf(out_path, encoding=enc)
        return dict(sub.sizes)


def process(year, month, bbox):
    stem = f"ncdd-{year}{month:02d}"
    raw_local = SCRATCH_DIR / f"{stem}-grd.nc"
    sub_local = SCRATCH_DIR / f"{stem}-{REGION}.nc"
    sub_share = DEST_DIR / f"{stem}-{REGION}.nc"

    if sub_share.exists() and sub_share.stat().st_size > 0:
        print(f"[SKIP] done already: {sub_share.name}", flush=True)
        return True

    if download_month(year, month, raw_local) is None:
        return False

    try:
        sizes = subset_month(raw_local, bbox, sub_local)
    except Exception as e:
        print(f"[FAIL] subsetting {raw_local.name}: {e}", flush=True)
        raw_local.unlink(missing_ok=True)      # likely a truncated download; force a redo
        return False

    print(f"[SUB ] {sub_local.name}  {sizes}  {sub_local.stat().st_size / 1e6:.2f} MB",
          flush=True)

    shutil.copy(sub_local, sub_share)          # plain byte copy -- no HDF5 on the share
    print(f"[COPY] -> {sub_share.name}", flush=True)

    raw_local.unlink(missing_ok=True)
    sub_local.unlink(missing_ok=True)
    return True


def main():
    if REGION not in BBOXES:
        sys.exit(f"Unknown REGION={REGION!r}. Options: {list(BBOXES)}")
    bbox = BBOXES[REGION]

    SCRATCH_DIR.mkdir(parents=True, exist_ok=True)
    DEST_DIR.mkdir(parents=True, exist_ok=True)

    months = list(month_iter(START_YEAR, START_MONTH, END_YEAR, END_MONTH))

    print("=" * 62)
    print(f"nClimGrid-Daily  |  {START_YEAR}-{START_MONTH:02d} .. {END_YEAR}-{END_MONTH:02d}"
          f"  ({len(months)} months)")
    print(f"Region   : {REGION}  bbox={bbox}")
    print(f"Vars     : {VARIABLES}")
    print(f"Scratch  : {SCRATCH_DIR}")
    print(f"Dest     : {DEST_DIR}")
    print("=" * 62 + "\n", flush=True)

    t0 = time.time()
    failed = []

    for i, (y, m) in enumerate(months, 1):
        elapsed = time.time() - t0
        eta = (elapsed / max(i - 1, 1)) * (len(months) - i + 1) if i > 1 else 0
        print(f"\n--- [{i}/{len(months)}] {y}-{m:02d}   "
              f"elapsed {timedelta(seconds=int(elapsed))}   "
              f"eta {timedelta(seconds=int(eta))} ---", flush=True)

        if not process(y, m, bbox):
            failed.append(f"{y}-{m:02d}")

    print("\n" + "=" * 62)
    print(f"FINISHED in {timedelta(seconds=int(time.time() - t0))}")

    done = sorted(DEST_DIR.glob(f"ncdd-*-{REGION}.nc"))
    total_mb = sum(p.stat().st_size for p in done) / 1e6
    print(f"{len(done)}/{len(months)} months on the share  ({total_mb:.1f} MB)")

    if failed:
        FAILED_FILE.write_text("\n".join(failed) + "\n")
        print(f"{len(failed)} failed -> {FAILED_FILE}")
        print("Rerun this script; completed months are skipped automatically.")
    else:
        print("No failures. Full record complete.")
    print("=" * 62)


if __name__ == "__main__":
    main()
